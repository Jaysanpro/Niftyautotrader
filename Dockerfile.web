# syntax=docker/dockerfile:1
#
# The web front end. The root Dockerfile builds the CLI image (one command,
# then exit); this one builds a long-lived HTTP service for Railway.

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Kolkata

WORKDIR /app

COPY pyproject.toml README.md ./
COPY tradingagents_in/__init__.py tradingagents_in/__init__.py
RUN pip install --upgrade pip && pip install -e ".[graph,data,llm,web]"

COPY tradingagents_in/ tradingagents_in/
COPY web/ web/

RUN mkdir -p /app/results /app/.cache \
    && useradd --create-home --uid 1000 ita \
    && chown -R ita:ita /app
USER ita

# Railway injects PORT; 8000 is only the local default. Exec form cannot expand
# it, so the shell form is deliberate here.
ENV PORT=8000
CMD ["sh", "-c", "uvicorn web.app:app --host 0.0.0.0 --port ${PORT}"]
