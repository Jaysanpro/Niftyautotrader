# ---------------------------------------------------------------------------
# IndianTradingAgents (TradingAgents-IN) - environment configuration
# Copy to `.env` and fill in what you need. Everything is optional except one
# LLM provider key (or set ITA_LLM_PROVIDER=offline to run the deterministic
# heuristic engine with no LLM at all).
# ---------------------------------------------------------------------------

# ------------------------- LLM provider selection --------------------------
# one of: openai | anthropic | google | xai | deepseek | qwen | groq | ollama
#         | openrouter | offline
ITA_LLM_PROVIDER=anthropic

# Two model tiers. Deep-think is used by researchers / trader / portfolio
# manager; quick-think by the analysts and summarisers.
ITA_DEEP_THINK_MODEL=claude-sonnet-4-5
ITA_QUICK_THINK_MODEL=claude-haiku-4-5
ITA_LLM_TEMPERATURE=0.2
ITA_LLM_MAX_TOKENS=4096

# ------------------------------ API keys -----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=          # Qwen
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the base URL of any OpenAI-compatible provider
ITA_LLM_BASE_URL=

# --------------------------- Research settings -----------------------------
ITA_MAX_DEBATE_ROUNDS=2          # bull vs bear rounds
ITA_MAX_RISK_ROUNDS=1            # risk manager review iterations
ITA_ONLINE_TOOLS=true            # allow network calls to data sources
ITA_LOOKBACK_DAYS=400

# --------------------------- Capital & risk --------------------------------
ITA_CAPITAL_INR=1000000          # total trading capital in INR
ITA_PROFILE=retail               # retail | institutional
ITA_RISK_PER_TRADE_PCT=1.0       # % of capital risked per idea
ITA_MAX_POSITION_PCT=10.0        # % of capital in a single symbol
ITA_MAX_SECTOR_PCT=25.0          # % of capital in one sector
ITA_MAX_PORTFOLIO_HEAT_PCT=6.0   # sum of open risk
ITA_MAX_DRAWDOWN_PCT=15.0
ITA_ALLOW_FNO=true
ITA_ALLOW_OVERNIGHT_FNO=true
ITA_ALLOW_SHORT_CASH=false       # naked cash shorts are intraday-only in India

# ------------------------------ Data sources -------------------------------
# yfinance | angelone | zerodha | synthetic
# synthetic = deterministic offline tape for CI/demos (a seeded random
# walk, not a market simulator - do not validate a strategy against it)
ITA_DATA_PROVIDER=yfinance
ITA_SYNTHETIC_SEED=              # fixed seed for reproducible synthetic runs
ITA_ENABLE_SCREENER_SCRAPE=false # Screener.in HTML scrape (respect their ToS)
ITA_CACHE_DIR=.cache/tradingagents_in
ITA_CACHE_TTL_SECONDS=900

# Angel One SmartAPI (optional)
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Zerodha Kite Connect (optional)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# TrueData (optional)
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=

# Social sentiment (all optional - agent degrades gracefully without them)
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tradingagents-in/0.1

# ----------------------------- Persistence ---------------------------------
ITA_RESULTS_DIR=results
ITA_MEMORY_FILE=trading_memory.md
ITA_CHECKPOINT_DB=checkpoints/graph.sqlite
ITA_ENABLE_CHECKPOINTS=false

# ------------------------------- Tracing -----------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tradingagents-in
